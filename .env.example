BOT_TOKEN=your_botfather_token_here

# Optional: path to a Netscape-format cookies file exported from a logged-in
# Instagram session in your browser. Needed if Instagram starts rate-limiting
# anonymous requests. Leave blank to skip.
INSTAGRAM_COOKIES_FILE=

# Max file size (MB) to send back via the standard Telegram Bot API.
# Bot API hard limit is 50MB unless you run a local Bot API server.
MAX_FILE_SIZE_MB=50
